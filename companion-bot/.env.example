# Get a Telegram bot token from @BotFather in Telegram.
TELEGRAM_BOT_TOKEN=put_your_telegram_bot_token_here

# Create a Groq API key at https://console.groq.com/keys.
# Free-tier limits apply. Never share this key or commit your real .env file.
GROQ_API_KEY=put_your_groq_api_key_here
AI_MODEL=openai/gpt-oss-20b

BOT_NAME=Nova
BOT_PERSONALITY=You are a warm, thoughtful, friendly Telegram AI companion. Be natural, respectful, supportive, and concise. Never claim to be human.
MAX_HISTORY_MESSAGES=16
DATABASE_PATH=companion.db
